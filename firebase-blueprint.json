{
  "entities": {
    "StockItem": {
      "title": "StockItem",
      "description": "Stock inventory items available for inquiry and sales",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product code or slug"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "innerDia": {
          "type": "string",
          "description": "Inner diameter metric specification"
        },
        "thickness": {
          "type": "string",
          "description": "Wall thickness metric specification"
        },
        "length": {
          "type": "string",
          "description": "Length metric specification"
        },
        "quantity": {
          "type": "string",
          "description": "Available stock quantity"
        },
        "condition": {
          "type": "string",
          "description": "Product quality condition"
        },
        "approxPrice": {
          "type": "string",
          "description": "Approximate pricing quote"
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary display photo URL"
        },
        "imageUrls": {
          "type": "array",
          "description": "Additional descriptive gallery photo URLs"
        },
        "desc": {
          "type": "string",
          "description": "Full technical description text paragraph"
        },
        "isCustom": {
          "type": "boolean",
          "description": "Whether this item was created/customized by the admin"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "name", "innerDia", "thickness", "length", "quantity", "condition", "approxPrice", "imageUrl"]
    },
    "DefenseNewsItem": {
      "title": "DefenseNewsItem",
      "description": "K-Defense news and intelligence articles",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique article ID"
        },
        "tab": {
          "type": "string",
          "description": "Category tab: suwon, domestic, or global"
        },
        "category": {
          "type": "string",
          "description": "Article subcategory name"
        },
        "title": {
          "type": "string",
          "description": "Article title headline"
        },
        "summary": {
          "type": "string",
          "description": "Short overview summary"
        },
        "source": {
          "type": "string",
          "description": "News source organization or outlet"
        },
        "date": {
          "type": "string",
          "description": "Publication date string (YYYY-MM-DD)"
        },
        "url": {
          "type": "string",
          "description": "External reference link"
        },
        "imageUrl": {
          "type": "string",
          "description": "Cover photo image URL"
        },
        "coreSummary": {
          "type": "string",
          "description": "Core takeaway bullet"
        },
        "bodyText": {
          "type": "string",
          "description": "Detailed article body content"
        },
        "perspective": {
          "type": "string",
          "description": "Suwon Paper Cone engineering and manufacturing viewpoint"
        },
        "isCustom": {
          "type": "boolean",
          "description": "True if created or customized by the admin to prevent overwrite"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "tab", "category", "title", "summary", "source", "date", "url"]
    }
  },
  "firestore": {
    "/stocks/{stockId}": {
      "schema": "StockItem",
      "description": "Global custom stock items collection synced in real-time"
    },
    "/defense_news/{newsId}": {
      "schema": "DefenseNewsItem",
      "description": "Defense news articles synchronized across admin consoles"
    }
  }
}
